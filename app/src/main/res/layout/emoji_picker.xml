<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/emoji_picker_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/emoji_picker_header_height"
        android:clipToPadding="true"
        android:paddingStart="@dimen/emoji_picker_header_padding"
        android:paddingEnd="@dimen/emoji_picker_header_padding" />

    <!-- This wrapper ends at the fixed control row. ImeService gives the child one internal
         spacer of overscan for AndroidX's cell calculation, then clips drawing and touch here
         and further clips the visible category viewport to three rows. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/emoji_picker_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GestureIme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.GestureIme.Setup" parent="Theme.GestureIme">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
